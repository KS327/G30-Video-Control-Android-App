<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/industrial_background">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/industrial_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="SYSTEM INITIALIZING"
            android:textColor="@color/industrial_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnViewMode"
            style="@style/IndustrialPrimaryButton"
            android:layout_width="94dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:text="VIEW · FOCUS" />

        <Button
            android:id="@+id/btnScan"
            style="@style/IndustrialButton"
            android:layout_width="76dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:text="SCAN" />

        <Button
            android:id="@+id/btnManualUrls"
            style="@style/IndustrialButton"
            android:layout_width="82dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:text="CAMERAS" />

        <Button
            android:id="@+id/btnStopVideo"
            style="@style/IndustrialDangerButton"
            android:layout_width="94dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:text="VIDEO STOP" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/operatorBar"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:background="@color/industrial_surface_raised"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:id="@+id/tvControlState"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="CH05 UNKNOWN\nSIMULATOR"
            android:textColor="@color/industrial_warning"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTelemetry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="SPEED —   ROLL —   PITCH —"
            android:textColor="@color/industrial_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTurnQueue"
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="TURN 0 / 6"
            android:textColor="@color/industrial_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnInternetArm"
            style="@style/IndustrialDangerButton"
            android:layout_width="112dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:text="INTERNET SAFE" />

        <Button
            android:id="@+id/btnAutonomousProcess"
            style="@style/IndustrialButton"
            android:layout_width="132dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:text="START AUTONOMOUS" />

        <Button
            android:id="@+id/btnAutonomousArm"
            style="@style/IndustrialDangerButton"
            android:layout_width="132dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:text="AUTONOMOUS SAFE" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cameraWall"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="3dp"
        app:layout_constraintBottom_toTopOf="@id/controlBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/operatorBar">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideVOneThird"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.3333" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideVTwoThird"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.6667" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideVHalf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideVFocus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.76" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideHHalf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.5" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideH20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.2" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideH40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.4" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideH60"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.6" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideH80"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.8" />

        <FrameLayout
            android:id="@+id/frameCam0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:background="@drawable/bg_camera_tile_selected"
            android:padding="2dp"
            app:layout_constraintBottom_toTopOf="@id/guideHHalf"
            app:layout_constraintEnd_toStartOf="@id/guideVOneThird"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.skydroid.fpvplayer.FPVWidget
                android:id="@+id/fpv0"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:id="@+id/gestureCam0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="36dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_camera_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvCam0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text="FRONT C12 · OFFLINE"
                    android:textColor="@color/industrial_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvC12GimbalState"
                    android:layout_width="82dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="GIMBAL OFFLINE"
                    android:textColor="@color/industrial_text_secondary"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnC12Center"
                    style="@style/IndustrialButton"
                    android:layout_width="70dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:enabled="false"
                    android:minHeight="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="CENTER"
                    android:textSize="8sp" />

                <Button
                    android:id="@+id/btnC12Mode"
                    style="@style/IndustrialPrimaryButton"
                    android:layout_width="72dp"
                    android:layout_height="32dp"
                    android:minHeight="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="VISIBLE"
                    android:textSize="9sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameCam1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:background="@drawable/bg_camera_tile"
            android:padding="2dp"
            app:layout_constraintBottom_toTopOf="@id/guideHHalf"
            app:layout_constraintEnd_toStartOf="@id/guideVTwoThird"
            app:layout_constraintStart_toStartOf="@id/guideVOneThird"
            app:layout_constraintTop_toTopOf="parent">
            <com.skydroid.fpvplayer.FPVWidget android:id="@+id/fpv1" android:layout_width="match_parent" android:layout_height="match_parent" />
            <View android:id="@+id/gestureCam1" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="36dp" android:background="@android:color/transparent" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/tvCam1" android:layout_width="match_parent" android:layout_height="36dp" android:background="@drawable/bg_camera_header" android:ellipsize="end" android:gravity="center_vertical" android:paddingStart="8dp" android:singleLine="true" android:text="CAMERA 2 · OFFLINE" android:textColor="@color/industrial_text_secondary" android:textSize="11sp" android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameCam2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:background="@drawable/bg_camera_tile"
            android:padding="2dp"
            app:layout_constraintBottom_toTopOf="@id/guideHHalf"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideVTwoThird"
            app:layout_constraintTop_toTopOf="parent">
            <com.skydroid.fpvplayer.FPVWidget android:id="@+id/fpv2" android:layout_width="match_parent" android:layout_height="match_parent" />
            <View android:id="@+id/gestureCam2" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="36dp" android:background="@android:color/transparent" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/tvCam2" android:layout_width="match_parent" android:layout_height="36dp" android:background="@drawable/bg_camera_header" android:ellipsize="end" android:gravity="center_vertical" android:paddingStart="8dp" android:singleLine="true" android:text="CAMERA 3 · OFFLINE" android:textColor="@color/industrial_text_secondary" android:textSize="11sp" android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameCam3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:background="@drawable/bg_camera_tile"
            android:padding="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideVOneThird"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/guideHHalf">
            <com.skydroid.fpvplayer.FPVWidget android:id="@+id/fpv3" android:layout_width="match_parent" android:layout_height="match_parent" />
            <View android:id="@+id/gestureCam3" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="36dp" android:background="@android:color/transparent" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/tvCam3" android:layout_width="match_parent" android:layout_height="36dp" android:background="@drawable/bg_camera_header" android:ellipsize="end" android:gravity="center_vertical" android:paddingStart="8dp" android:singleLine="true" android:text="CAMERA 4 · OFFLINE" android:textColor="@color/industrial_text_secondary" android:textSize="11sp" android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameCam4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:background="@drawable/bg_camera_tile"
            android:padding="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideVTwoThird"
            app:layout_constraintStart_toStartOf="@id/guideVOneThird"
            app:layout_constraintTop_toTopOf="@id/guideHHalf">
            <com.skydroid.fpvplayer.FPVWidget android:id="@+id/fpv4" android:layout_width="match_parent" android:layout_height="match_parent" />
            <View android:id="@+id/gestureCam4" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="36dp" android:background="@android:color/transparent" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/tvCam4" android:layout_width="match_parent" android:layout_height="36dp" android:background="@drawable/bg_camera_header" android:ellipsize="end" android:gravity="center_vertical" android:paddingStart="8dp" android:singleLine="true" android:text="CAMERA 5 · OFFLINE" android:textColor="@color/industrial_text_secondary" android:textSize="11sp" android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameCam5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:background="@drawable/bg_camera_tile"
            android:padding="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideVTwoThird"
            app:layout_constraintTop_toTopOf="@id/guideHHalf">
            <com.skydroid.fpvplayer.FPVWidget android:id="@+id/fpv5" android:layout_width="match_parent" android:layout_height="match_parent" />
            <View android:id="@+id/gestureCam5" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="36dp" android:background="@android:color/transparent" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/tvCam5" android:layout_width="match_parent" android:layout_height="36dp" android:background="@drawable/bg_camera_header" android:ellipsize="end" android:gravity="center_vertical" android:paddingStart="8dp" android:singleLine="true" android:text="CAMERA 6 · NOT SET" android:textColor="@color/industrial_text_secondary" android:textSize="11sp" android:textStyle="bold" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="@color/industrial_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button android:id="@+id/btnL2" style="@style/IndustrialButton" android:layout_width="62dp" android:layout_height="48dp" android:text="L2" />
        <Button android:id="@+id/btnL1" style="@style/IndustrialButton" android:layout_width="62dp" android:layout_height="48dp" android:layout_marginStart="5dp" android:text="L1" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/speedScaleRow"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvSpeedLabel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingEnd="8dp"
                android:text="SPEED SETTING"
                android:textColor="@color/industrial_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView android:id="@+id/speedBubble0" style="@style/SpeedBubble" android:text="0" />
            <TextView android:id="@+id/speedBubble1" style="@style/SpeedBubble" android:text="1" />
            <TextView android:id="@+id/speedBubble2" style="@style/SpeedBubble" android:text="2" />
            <TextView android:id="@+id/speedBubble3" style="@style/SpeedBubble" android:text="3" />
            <TextView android:id="@+id/speedBubble4" style="@style/SpeedBubble" android:text="4" />
            <TextView android:id="@+id/speedBubble5" style="@style/SpeedBubble" android:text="5" />
            <TextView android:id="@+id/speedBubble6" style="@style/SpeedBubble" android:text="6" />
        </LinearLayout>

        <Button
            android:id="@+id/btnUdpTarget"
            style="@style/IndustrialPrimaryButton"
            android:layout_width="84dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:text="LOCAL" />

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <Button android:id="@+id/btnR1" style="@style/IndustrialButton" android:layout_width="62dp" android:layout_height="48dp" android:text="R1" />
        <Button android:id="@+id/btnR2" style="@style/IndustrialButton" android:layout_width="62dp" android:layout_height="48dp" android:layout_marginStart="5dp" android:text="R2" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
