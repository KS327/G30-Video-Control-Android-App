<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#202020"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="UDP ready: 192.168.144.20:5005"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:textSize="10sp"
            android:text="Scan" />

        <Button
            android:id="@+id/btnManualUrls"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:textSize="10sp"
            android:text="Manual URLs" />

        <Button
            android:id="@+id/btnDefaultC12"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:textSize="10sp"
            android:text="C12" />

        <Button
            android:id="@+id/btnStopVideo"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:textSize="10sp"
            android:text="Stop Video" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/videoGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="2"
        android:rowCount="2"
        android:padding="2dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/speedScaleRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/frameCam0"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:background="#000000">
            <com.skydroid.fpvplayer.FPVWidget
                android:id="@+id/fpv0"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <TextView
                android:id="@+id/tvCam0"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:background="#66000000"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="CAM 1: not set"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameCam1"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:background="#000000">
            <com.skydroid.fpvplayer.FPVWidget
                android:id="@+id/fpv1"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <TextView
                android:id="@+id/tvCam1"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:background="#66000000"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="CAM 2: not set"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameCam2"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:background="#000000">
            <com.skydroid.fpvplayer.FPVWidget
                android:id="@+id/fpv2"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <TextView
                android:id="@+id/tvCam2"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:background="#66000000"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="CAM 3: not set"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameCam3"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:background="#000000">
            <com.skydroid.fpvplayer.FPVWidget
                android:id="@+id/fpv3"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <TextView
                android:id="@+id/tvCam3"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:background="#66000000"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="CAM 4: not set"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </FrameLayout>
    </GridLayout>

    <LinearLayout
        android:id="@+id/speedScaleRow"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlBar">

        <TextView
            android:id="@+id/speedBubble0"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:text="0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/speedBubble1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:text="1"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/speedBubble2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:text="2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/speedBubble3"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:text="3"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/speedBubble4"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:text="4"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/speedBubble5"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:text="5"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="#202020"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnL2"
            android:layout_width="66dp"
            android:layout_height="46dp"
            android:textSize="14sp"
            android:text="L2" />

        <Button
            android:id="@+id/btnL1"
            android:layout_width="66dp"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:textSize="14sp"
            android:text="L1" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnUdpTarget"
            android:layout_width="138dp"
            android:layout_height="46dp"
            android:textSize="10sp"
            android:text="UDP\n192.168.144.20" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnR1"
            android:layout_width="66dp"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:textSize="14sp"
            android:text="R1" />

        <Button
            android:id="@+id/btnR2"
            android:layout_width="66dp"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:textSize="14sp"
            android:text="R2" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
