<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/industrial_background</item>
        <item name="android:windowBackground">@color/industrial_background</item>
        <item name="colorPrimary">@color/industrial_primary</item>
        <item name="colorPrimaryVariant">@color/industrial_primary_dark</item>
        <item name="colorSecondary">@color/industrial_primary</item>
        <item name="colorSurface">@color/industrial_surface</item>
        <item name="colorOnSurface">@color/industrial_text_primary</item>
    </style>

    <style name="IndustrialButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/industrial_text_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="backgroundTint">@color/industrial_surface_raised</item>
        <item name="cornerRadius">4dp</item>
        <item name="strokeColor">@color/industrial_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="IndustrialPrimaryButton" parent="IndustrialButton">
        <item name="backgroundTint">@color/industrial_primary_dark</item>
        <item name="strokeColor">@color/industrial_primary</item>
    </style>

    <style name="IndustrialDangerButton" parent="IndustrialButton">
        <item name="backgroundTint">@color/industrial_danger</item>
        <item name="strokeColor">@color/industrial_danger</item>
    </style>

    <style name="SpeedBubble">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
